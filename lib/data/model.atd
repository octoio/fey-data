type transform <ocaml from="Common"> = abstract
type entity_reference <ocaml from="Common"> = abstract

type shadow_casting_mode = 
  [ Off
  | On
  | TwoSided
  | ShadowsOnly
  ]

type model =
  { path : string <ocaml valid="Validation.validate_file \"model/\" \".glb\"">;
    transform : transform;
    shadow_casting_mode: shadow_casting_mode;
  }

type model_anchor_position = 
    [ None
    | HeadAnchor
    | EyesAnchor
    | EaringsAnchor
    | FaceAccessoryAnchor
    | BackAnchor
    | NeckAnchor
    | ShoulderLeftAnchor
    | ShoulderRightAnchor
    | ForearmLeftAnchor
    | ForearmRightAnchor
    | HandLeftAnchor
    | HandRightAnchor
    | ChestAnchor
    | WaistAnchor
    | LegsAnchor
    | FootLeftAnchor
    | FootRightAnchor
    | MainHandAnchor
    | OffHandAnchor
    | TwoHandAnchor
    | HipLeftAnchor
    | HipRightAnchor
    ]

type model_variant =
    [ Primary
    | Sheathed
    ]

type model_anchor = {
    position: model_anchor_position;
    local_transform: transform;
    variant: model_variant;
}

type model_anchor_set = {
    model_reference: entity_reference <ocaml valid="Validation.entity_reference_of_type `Model">;
    anchors: model_anchor list;
}
