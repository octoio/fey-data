type entity_reference <ocaml from="Common"> = abstract
type hit_type <ocaml from="Common"> = abstract
type stat_type <ocaml from="Stat"> = abstract
type float_range <ocaml from="Common"> = abstract

type character_team = 
  [ Ally
  | Enemy
  | Neutral
  ]

type effect_target_mechanic_type =
  [ Self
  | Team
  | Selected
  | Circle
  | Rectangle
  ]

type effect_target_mechanic = {
  mechanic_type <json name="type">: effect_target_mechanic_type;
}

type effect_target_mechanic_self = {
  mechanic_type <json name="type">: effect_target_mechanic_type;
}

type effect_target_mechanic_team = {
  mechanic_type <json name="type">: effect_target_mechanic_type;
  team: character_team;
}

type effect_target_mechanic_selected = {
  mechanic_type <json name="type">: effect_target_mechanic_type;
}

type effect_target_mechanic_circle = {
  mechanic_type <json name="type">: effect_target_mechanic_type;
  hit_count: int <ocaml valid="Validation.int_min 1">;
  radius: float;
}

type effect_target_mechanic_rectangle = {
  mechanic_type <json name="type">: effect_target_mechanic_type;
  hit_count: int <ocaml valid="Validation.int_min 1">;
  width: float;
  height: float;
}

type effect_target_mechanic_internal =
  [ Self of effect_target_mechanic_self
  | Team of effect_target_mechanic_team
  | Selected of effect_target_mechanic_selected
  | Circle of effect_target_mechanic_circle
  | Rectangle of effect_target_mechanic_rectangle
  ] <json adapter.ocaml="Atdgen_runtime.Json_adapter.Type_field">

type effect_target = 
  [ Ally
  | Enemy
  | Any
  ]

type effect_scaling = {
  base: float;
  scaling: float_range;
  stat: stat_type;
}

(* A damage bonus on a weak target: a Damage hit on a target whose health is below [below] (a fraction of its
   maximum health, in (0, 1]) deals [factor] times the damage (at least 1) *)
type execute_bonus = {
  below: float;
  factor: float;
} <ocaml valid="Validation.validate_execute_bonus">

(* The resistance a damage hit is mitigated by: Armor (Physical) or MagicResist (Magical) *)
type damage_school =
  [ Physical
  | Magical
  ]

(* [school] (Damage and Heal hits only): every scaler of this hit feeds that school, so a damage hit is mitigated by
   its Armor (Physical) or MagicResist (Magical) whatever the scaler stats are. Absent: each scaler goes to the
   school of its stat (AbilityPower, Int, Mana, MagicResist are magical, every other stat is physical). A heal is
   never mitigated; its school only labels the breakdown. Any other hit type with a school is an error.
   [execute] (Damage hits only): see execute_bonus. [knockback] (Damage hits only): units a target that survives the
   hit is pushed straight away from the caster, stopped by obstacles and the stage bounds (positive).
   [pull] (Damage hits only, not with a knockback): units a target that survives the hit is dragged back the way the
   caster came, i.e. straight behind the caster's facing, which after a dash is toward the spot the dash left; it
   moves like a dash (the Move node's motion), stopped short of obstacles (positive). *)
type hit_effect = {
  hit_type: hit_type;
  scalers: effect_scaling list;
  target_mechanic: effect_target_mechanic_internal;
  target: effect_target;
  hit_sound: entity_reference;
  can_crit: bool;
  can_miss: bool;
  ?school: damage_school option;
  ?execute: execute_bonus option;
  ?knockback: float option;
  ?pull: float option;
} <ocaml valid="Validation.validate_hit_effect">

(* Where a status duration type lives: in effect.atd so that status.atd can import trigger.atd (which imports this file) *)
type status_duration_type =
    [ Chrono
    | Logical
    | Room
    | Dungeon
    ]

type status_duration = {
    duration <json name="type">: status_duration_type;
    value: float <ocaml valid="Validation.float_min 0.">;
}

type status_effect = {
  target_mechanic: effect_target_mechanic_internal;
  target: effect_target;
  durations: status_duration list;
  scalers: effect_scaling list;
  status: entity_reference <ocaml valid="Validation.entity_reference_of_type `Status">;
  (* true: remove the status from the targets instead of applying it (a dispel or cleanse); durations and scalers must then be empty *)
  ?dispel: bool option;
} <ocaml valid="Validation.validate_status_effect">
