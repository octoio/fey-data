type metadata <ocaml from="Common"> = abstract
type xp_chart <ocaml from="Common"> = abstract
type vector3 <ocaml from="Common"> = abstract
type color <ocaml from="Common"> = abstract
type entity_reference <ocaml from="Common"> = abstract
type skill_type <ocaml from="Common"> = abstract
type stat_sheet <ocaml from="Stat"> = abstract
type status_effect <ocaml from="Effect"> = abstract
type visual_layer <ocaml from="Visual"> = abstract

type character_type = 
  [ Adventurer
  | Slime
  | Boar
  | Beast
  ]

(* Whom a character sides with. Factions are separate from the controller: who steers a character (an AI brain or
   any client) can change at runtime, its faction does not. Whether two factions fight is a relation between them
   (hostile, neutral or friendly), decided by the game rules, not per character. Players are Adventurers. *)
type faction =
  [ Adventurers
  | Wilds
  | Slimes
  | Crypt
  | Neutral
  ]

(* How dangerous a monster is: scales the rarity of its drops and unlocks gated drops (see drop.atd) *)
type monster_rank =
  [ Normal
  | Elite
  | Boss
  ]

type character_variant_color_type = 
  [ Primary
  | Secondary
  | Tertiary
  | Other
  ]

type character_variant_color = 
  { color_type <json name="type">: character_variant_color_type;
    color: color;
  }


type character_variant = 
  { colors: character_variant_color list;
    scale: vector3;
  }

(* A monster that gets angrier the longer a fight lasts: [after] seconds after it entered combat, the
   [effects] are applied to it (each one must target [Self]; the monster is also the source), and they end when
   the fight does. Absent = no enrage timer. *)
type enrage = {
  after: float <ocaml valid="Validation.float_min 1.">;
  effects: status_effect list <ocaml valid="Validation.validate_enrage_effects">;
}

(* What each level above 1 adds to the character's stats (so level n adds [n - 1] times these, a stat source of its
   own). Every field is absent (0) by default. [max_level] caps the character level: XP stops accruing there.
   Growth stays small on purpose: skills and gear should matter more than grinding. When a level-up raises the
   maximum health or mana, current health and mana rise by the same amount (no full heal). *)
type level_growth = {
  ?max_level: int option <ocaml valid="Validation.validate_max_level">;
  ?vit: float option <ocaml valid="Validation.validate_growth">;
  ?str: float option <ocaml valid="Validation.validate_growth">;
  ?_int <json name="int">: float option <ocaml valid="Validation.validate_growth">;
  ?dex: float option <ocaml valid="Validation.validate_growth">;
  ?health: float option <ocaml valid="Validation.validate_growth">;
  ?mana: float option <ocaml valid="Validation.validate_growth">;
  ?armor: float option <ocaml valid="Validation.validate_growth">;
  ?magic_resist: float option <ocaml valid="Validation.validate_growth">;
}

(* A breeding nest: a monster-side object the party breaks. It is placed on its anchor point (never scattered), has no
   brain and does not move or attack; a quest breeds from it (the StartEscalation action). When its health falls to
   [burst_at] (a fraction of the maximum, 0 to 1) it bursts once: [burst_count] monsters of [burst] come out of it
   and go for the party. *)
type nest = {
  burst_at: float <ocaml valid="Validation.float_between 0.05 0.95">;
  burst: entity_reference <ocaml valid="Validation.entity_reference_of_type `Character">;
  burst_count: int <ocaml valid="Validation.int_min 1">;
}

type character =
  { metadata: metadata;
    character_type <json name="type">: character_type;
    ?variant: character_variant option;
    (* The side the character fights for; absent = Neutral (attacked by nobody, attacks nobody) *)
    ?faction: faction option;
    pivot_offset: vector3;
    vision_range: float;
    auto_attack: entity_reference <ocaml valid="Validation.entity_reference_of_type `Skill">;
    skills: entity_reference list <ocaml valid="Validation.entity_reference_list_of_type 0 `Skill">;
    stat_sheet: stat_sheet;
    drop_table: entity_reference <ocaml valid="Validation.entity_reference_of_type `DropTable">;
    foot_step_sound: entity_reference <ocaml valid="Validation.entity_reference_of_type `Sound">;
    hit_sound: entity_reference <ocaml valid="Validation.entity_reference_of_type `Sound">;
    (* Character level curve; absent = the game default *)
    ?xp_chart: xp_chart option;
    (* Starting level (absent = 1). Stats only change through [level_growth]; a monster's level scales the character
       XP its kill pays and, against the level of its opponent, the damage it deals and takes. *)
    ?level: int option;
    (* Per-level stat growth and level cap, see [level_growth]; absent = levels change no stats *)
    ?level_growth: level_growth option;
    (* Normal (absent), Elite or Boss: drop tables gate and tilt their rewards by it *)
    ?rank: monster_rank option;
    (* Enrage timer, see [enrage] *)
    ?enrage: enrage option;
    (* true: the monster goes for whoever in reach carries a healing skill instead of the threat holder
       (a taunt still wins) *)
    ?hunts_healers: bool option;
    (* true: the character is not slowed by water ground (stage [ground_zone]). Absent = false. *)
    ?swims: bool option;
    (* Present: the character is a breeding nest, see [nest] *)
    ?nest: nest option;
    (* Player characters: the equipment and weapons a new character starts with (equipped on creation);
       absent = nothing *)
    ?starting_equipment: entity_reference list option <ocaml valid="Validation.entity_reference_list_of_type_if_some `Equipment">;
    ?starting_weapons: entity_reference list option <ocaml valid="Validation.entity_reference_list_of_type_if_some `Weapon">;
    (* 3D look of a monster: the model family (its own skeleton and clips; the pack's model key is the family, or
       "<family>-<variant>" when the first fixed layer is a "body_<variant>" colour) and the layers shown, usually a
       single body layer. Absent: the client draws the character's default look. A weapon class is not needed, the
       attack cue comes from the skill. *)
    ?model_family: string option <ocaml valid="Validation.validate_model_family_if_some">;
    ?visual_layers: visual_layer list option;
  }
