type entity_reference <ocaml from="Common"> = abstract
type metadata <ocaml from="Common"> = abstract
type int_range <ocaml from="Common"> = abstract
type skill_category <ocaml from="Skill"> = abstract
type requirement_evaluation <ocaml from="Requirement"> = abstract
type monster_rank <ocaml from="Character"> = abstract
type quality_type <ocaml from="Quality"> = abstract

type drop_type = 
  [ Equipment
  | Weapon
  | Skill
  | SkillBook
  ]

type drop =
  { drop_type <json name="type">: drop_type;
    weight: int <ocaml valid="Validation.int_min 1">;
  }

(* Restricts an item entry to stronger monsters. [min_level] / [min_rank] are hard requirements on the
   killed monster (its character level, default 1; its rank, default Normal). A monster below [min_rank]
   (but not below [min_level]) can still drop the entry at weight [lower_rank_weight] instead of its
   own: the low odds a unique has from level-appropriate trash. Without [lower_rank_weight] the rank is
   a hard gate. *)
type drop_gate =
  { ?min_level: int option;
    (* the quest tier (QuestTier order) the quest must be played at: a unique of the hardest tier *)
    ?min_tier: int option;
    ?min_rank: monster_rank option;
    ?lower_rank_weight: int option;
  } <ocaml valid="Validation.validate_drop_gate">

type equipment_drop =
  { drop_type <json name="type">: drop_type;
    weight: int <ocaml valid="Validation.int_min 1">;
    equipment: entity_reference <ocaml valid="Validation.entity_reference_of_type `Equipment">;
    (* Who can drop it: absent = every monster *)
    ?gate: drop_gate option;
  }

type weapon_drop =
  { drop_type <json name="type">: drop_type;
    weight: int <ocaml valid="Validation.int_min 1">;
    weapon: entity_reference <ocaml valid="Validation.entity_reference_of_type `Weapon">;
    (* Who can drop it: absent = every monster *)
    ?gate: drop_gate option;
  }

type skill_drop =
  { drop_type <json name="type">: drop_type;
    weight: int <ocaml valid="Validation.int_min 1">;
    skill: entity_reference <ocaml valid="Validation.entity_reference_of_type `Skill">;
  }

(* A skill book item (the way skills drop in fey-rs; the plain [skill_drop] is the old direct offer, unused there) *)
type skill_book_drop =
  { drop_type <json name="type">: drop_type;
    weight: int <ocaml valid="Validation.int_min 1">;
    skill_book: entity_reference <ocaml valid="Validation.entity_reference_of_type `SkillBook">;
    (* Who can drop it: absent = every monster *)
    ?gate: drop_gate option;
  }

type drop_internal =
  [ Equipment of equipment_drop
  | Weapon of weapon_drop
  | Skill of skill_drop
  | SkillBook of skill_book_drop
  ] <json adapter.ocaml="Atdgen_runtime.Json_adapter.Type_field">

type drop_evaluation =
  { operator: requirement_evaluation;
    drops: drop_internal list;
  }

(* Relative weights of the rarity tiers (Common..Legendary) for the item drops of a table. A tier
   with no eligible entry is skipped; weights are not percentages, only the sum must be positive. *)
type rarity_weights =
  { common: int <ocaml valid="Validation.int_min 0">;
    uncommon: int <ocaml valid="Validation.int_min 0">;
    rare: int <ocaml valid="Validation.int_min 0">;
    epic: int <ocaml valid="Validation.int_min 0">;
    legendary: int <ocaml valid="Validation.int_min 0">;
  } <ocaml valid="Validation.validate_rarity_weights">

(* The rarity of an item drop is rolled from [weights], tilted towards the rarer tiers: the weight of
   tier i (Common = 0 ... Legendary = 4) is multiplied by (1 + tilt)^i, where
   tilt = per_level * (monster level - 1) + the monster rank's tilt (all default 0). *)
type rarity_curve =
  { weights: rarity_weights;
    ?per_level: float option <ocaml valid="Validation.float_min_if_some 0.">;
    ?elite_tilt: float option <ocaml valid="Validation.float_min_if_some 0.">;
    ?boss_tilt: float option <ocaml valid="Validation.float_min_if_some 0.">;
  }

(* A monster of at least [min_rank] always drops one item of [kind] (Equipment, Weapon or SkillBook)
   whose rarity is at least [min_quality]. With [per_player] (absent: false; only for Equipment or Weapon)
   the item is rolled once for each character credited with the kill and is that character's own: no
   Need / Greed roll. *)
type drop_guarantee =
  { min_rank: monster_rank;
    kind: drop_type <ocaml valid="Validation.validate_guarantee_kind">;
    min_quality: quality_type <ocaml valid="Validation.validate_guarantee_quality">;
    ?per_player: bool option;
  } <ocaml valid="Validation.validate_guarantee">

(* The chances that one kill drops a piece of equipment and a weapon (before [party_scaling]). *)
type item_rule =
  { equipment: float <ocaml valid="Validation.float_between 0. 1.">;
    weapon: float <ocaml valid="Validation.float_between 0. 1.">;
  }

(* The item chances of a table, per rank of the killed monster. *)
type item_chances =
  { normal: item_rule;
    elite: item_rule;
    boss: item_rule;
  }

(* The gold one kill of a rank drops: with probability [chance] the kill drops a whole amount in [amount],
   the same for every eligible player. *)
type gold_rule =
  { chance: float <ocaml valid="Validation.float_between 0. 1.">;
    amount: int_range <ocaml valid="Validation.int_range_between {min=1; max=1000}">;
  }

(* The gold of a table, per rank of the killed monster. The rolled amount grows with the monster:
   it is multiplied by (1 + per_level * (level - 1)) and by the quest tier's gold multiplier, rounded to the
   nearest whole number, at least 1. Absent [per_level]: the amount does not grow with the level. *)
type gold_drops =
  { ?per_level: float option <ocaml valid="Validation.float_min_if_some 0.">;
    normal: gold_rule;
    elite: gold_rule;
    boss: gold_rule;
  }

(* Who gets a drop. Poll (default): every eligible player rolls Need / Greed / Pass for each item.
   Everyone: each eligible player receives their own copy at once. Individual: one eligible player
   (drawn per item, with a pity bonus for those who have won less) receives it at once. Gold is never split: with
   Individual each eligible player rolls their own, otherwise one roll pays every eligible player in full. *)
type loot_distribution =
  [ Poll
  | Everyone
  | Individual
  ]

type drop_table =
  { metadata: metadata;
    (* Absent: the table drops no gold *)
    ?gold: gold_drops option;
    equipment_drops: drop_internal list <ocaml valid="Validation.drop_list_of_type 0 `Equipment">;
    weapon_drops: drop_internal list <ocaml valid="Validation.drop_list_of_type 0 `Weapon">;
    skill_book_drops: drop_internal list <ocaml valid="Validation.drop_list_of_type 0 `SkillBook">;
      (* Absent: items are picked by entry weight alone *)
    ?rarity_curve: rarity_curve option;
    ?guarantees: drop_guarantee list option;
    (* Required when the table has equipment or weapon entries; absent: those chances are 0 *)
    ?item_chances: item_chances option;
    (* Absent: Poll *)
    ?distribution: loot_distribution option;
    (* Each eligible player beyond the first multiplies the chance of every item category by
       (1 + party_scaling), capped at 1; absent = drops do not depend on the party size *)
    ?party_scaling: float option <ocaml valid="Validation.float_min_if_some 0.">;
  }
