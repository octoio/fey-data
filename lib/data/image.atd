type size <ocaml from="Common"> = abstract
type entity_reference <ocaml from="Common"> = abstract

type image_type = 
    [ Texture
    | Sprite
    ]

type image =
  { image_type <json name="type">: image_type;  
    path: string <ocaml valid="Validation.validate_file \"image/\" \".png\"">;
    size: size
  }
