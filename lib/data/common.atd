type vector2 =
  { x : float;
    y : float
  }

type vector3 =
  { x : float;
    y : float;
    z : float
  }

type float_range =
  { min : float;
    max : float
  }

(* An experience curve: XP to leave level 1 is [base]; leaving level n costs
   base + sum_{k=0}^{n-2} floor(increment * growth^k). *)
type xp_chart =
  { base: int <ocaml valid="Validation.int_min 1">;
    increment: float <ocaml valid="Validation.float_min 0.">;
    growth: float <ocaml valid="Validation.float_min 0.">
  }

type int_range =
  { min : int;
    max : int
  }

type metadata =
  { title : string;
    description : string
  }

type size =
  { width : int;
    height : int
  }

type color =
  { r : float <ocaml valid="Validation.float_between 0. 1.">;
    g : float <ocaml valid="Validation.float_between 0. 1.">;
    b : float <ocaml valid="Validation.float_between 0. 1.">;
    a : float <ocaml valid="Validation.float_between 0. 1.">
  }

type transform =
  { position : vector3;
    rotation : vector3;
    scale : vector3
  }

type entity_type = 
  [ Model
  | Skill
  | Weapon
  | Equipment
  | Image
  | Status
  | Cursor
  | Stat
  | Quality
  | AudioClip
  | Sound
  | SoundBank
  | DropTable
  | Character
  | AnimationSource
  | Animation
  | Projectile
  | Quest
  | QuestDifficulty
  | Anchor
  | Stage
  | SkillStone
  | WeaponClass
  | RoomPrefab
  | Achievement
  | Balance
  ]

type entity_reference =
  { owner: string;
    entity_type <json name="type"> : entity_type;
    key: string;
    version: int;
    id: string;
  } <ocaml valid="Validation.validate_entity_reference">

type hit_type =
  [ Damage
  | Heal
  | Threat
  | Mana
  | Revive  (* stands a dead ally up; the first scaler's base is the percent of its maximum health and mana it returns with *)
  ]

  (* TODO: remove this from the weapon file *)
type skill_type = 
  [ None
  | HealingZone
  | DoubleSlash
  | FireZone
  | MagicBolt
  | HealingOverTime
  | Taunt
  | FlashHeal
  | MovementSpeedBoost
  | Punch
  | Slash
  | BluntStrike
  | WideSwing
  | TwinStrike
  | SlimyStrike
  | SlimySurge
  | SlimyDrag
  | SlimyRecovery
  | SlimyReinforcements
  | PiercingThrust
  | RavageBlow
  | PebbleThrow
  | Stomp
  | TuskStrike
  ]

type highlight_type =
  [ MouseOver
  | Selected
  ]

type target_type =
  [ Character
  | Drop
  | DeadCharacter
  | QuestBoard
  | Portal
  ]

type zone_type =
  [ StartQuestZone
  | StayInZone
  ]
