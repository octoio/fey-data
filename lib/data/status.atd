type metadata <ocaml from="Common"> = abstract
type hit_type <ocaml from="Common"> = abstract
type stat_type <ocaml from="Stat"> = abstract
type entity_reference <ocaml from="Common"> = abstract
type trigger <ocaml from="Trigger"> = abstract
type status_vfx <ocaml from="Vfx"> = abstract

type status_effect_mechanic_type =
    [ StatChange
    | HitOverTime
    | Control
    | CrowdControl
    | Shield
    | Submerge
    ]

type status_effect_mechanic = {
    mechanic_type <json name="type">: status_effect_mechanic_type;
}

type status_effect_mechanic_stat_change = {
    mechanic_type <json name="type">: status_effect_mechanic_type;
    stat: stat_type;
}

type status_effect_mechanic_internal =
    [ StatChange of status_effect_mechanic_stat_change
    | HitOverTime of status_effect_mechanic_hit_over_time
    | Control of status_effect_mechanic_control
    | CrowdControl of status_effect_mechanic_crowd_control
    | Shield of status_effect_mechanic_shield
    | Submerge of status_effect_mechanic_submerge
    ] <json adapter.ocaml="Atdgen_runtime.Json_adapter.Type_field">

(* A damage-absorbing pool: the status effect's scaler is the pool size; damage is soaked before health,
   oldest application first, and a drained shield ends (EndReason Consumed) *)
type status_effect_mechanic_shield = {
    mechanic_type <json name="type">: status_effect_mechanic_type;
}

(* The afflicted is under the surface while it lasts: nothing can target or hit it, not even an area effect, and it is
   unseen (only a ripple shows where it is) *)
type status_effect_mechanic_submerge = {
    mechanic_type <json name="type">: status_effect_mechanic_type;
}

type status_effect_mechanic_hit_over_time = {
    mechanic_type <json name="type">: status_effect_mechanic_type;
    hit: hit_type;
    tick_rate: float <ocaml valid="Validation.float_min 0.1">;
}

(* How a Control status moves controllers while it lasts (the Chrono duration of the status effect is the time) *)
type status_control_mode =
    [ Shuffle         (* the controllers of the afflicted characters rotate among them *)
    | SwapWithSource  (* the caster and the first afflicted character exchange controllers *)
    | Dominate        (* the caster takes control of the afflicted character; a player caster's own body idles *)
    ]

type status_effect_mechanic_control = {
    mechanic_type <json name="type">: status_effect_mechanic_type;
    mode: status_control_mode;
}

(* What a CrowdControl status takes away from the afflicted while it lasts. A slow is not one of these: it is a StatChange on MovementSpeedModifier (a percentage). *)
type crowd_control_effect =
    [ Stun     (* cannot move or cast; a running cast is interrupted when it lands *)
    | Root     (* cannot move; casting is unaffected *)
    | Silence  (* cannot cast, a running cast is interrupted when it lands; movement is unaffected *)
    | Taunt    (* an AI-controlled afflicted character must attack the source of the status; it can still do everything *)
    ]

type status_effect_mechanic_crowd_control = {
    mechanic_type <json name="type">: status_effect_mechanic_type;
    effect: crowd_control_effect;
}

type status_stack_scaling_strategy =
    [ Additive
    | Multiplicative
    ]

(* What happens when a status already at its maximum stack size is applied again. *)
type status_full_stack_rule =
    [ RefreshAll       (* no stack is replaced; the duration of the whole stack is reset (the default) *)
    | ReplaceOldest    (* the oldest application drops and the new one is added *)
    | ReplaceWeakest   (* the weakest stack is swapped for the new one, only if the new one is stronger *)
    ]

type status_stack = {
    size: int <ocaml valid="Validation.int_min 1">;
    scaling_strategy: status_stack_scaling_strategy;
    (* absent means RefreshAll *)
    ?full_stack: status_full_stack_rule option;
}

type status = {
    metadata: metadata;
    mechanic: status_effect_mechanic_internal;
    stack: status_stack;
    (* Every application of the status ends early once its SOURCE has taken this fraction of its maximum health in
       damage since the application (a grab that the others break with a burst of damage) *)
    ?break_burst: float option <ocaml valid="Validation.validate_break_burst">;
    (* effects that fire on something happening to the afflicted character while it has the status (see trigger.atd) *)
    ?triggers: trigger list option <ocaml valid="Validation.validate_triggers">;
  (* the effect on the afflicted character while the status lasts (see vfx.atd) *)
  ?vfx: status_vfx option;
}
