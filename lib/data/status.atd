type metadata <ocaml from="Common"> = abstract
type hit_type <ocaml from="Common"> = abstract
type stat_type <ocaml from="Stat"> = abstract
type entity_reference <ocaml from="Common"> = abstract
type trigger <ocaml from="Trigger"> = abstract

type status_effect_mechanic_type <cs name="StatusEffectMechanic" namespace="Octoio.Fey.Data.Type"> =
    [ StatChange
    | HitOverTime
    | Control
    | CrowdControl
    | Shield
    ]

type status_effect_mechanic <cs namespace="Octoio.Fey.Data.Dto" modifiers="abstract,partial"> = {
    mechanic_type <json name="type"> <cs usetype="Type.StatusEffectMechanic">: status_effect_mechanic_type;
}

type status_effect_mechanic_stat_change <cs namespace="Octoio.Fey.Data.Dto" extends="StatusEffectMechanic" modifiers="partial"> = {
    mechanic_type <json name="type"> <cs ignore="true">: status_effect_mechanic_type;
    stat <cs usetype="Type.Stat">: stat_type;
}

type status_effect_mechanic_internal <cs generators="visitor(namespace=Octoio.Fey.Data.Dto,nameprefix=StatusEffectMechanic),converter(namespace=Octoio.Fey.Data.Mapper,nameprefix=StatusEffectMechanic)"> =
    [ StatChange of status_effect_mechanic_stat_change
    | HitOverTime of status_effect_mechanic_hit_over_time
    | Control of status_effect_mechanic_control
    | CrowdControl of status_effect_mechanic_crowd_control
    | Shield of status_effect_mechanic_shield
    ] <json adapter.ocaml="Atdgen_runtime.Json_adapter.Type_field">

(* A damage-absorbing pool: the status effect's scaler is the pool size; damage is soaked before health,
   oldest application first, and a drained shield ends (EndReason Consumed) *)
type status_effect_mechanic_shield <cs namespace="Octoio.Fey.Data.Dto" extends="StatusEffectMechanic" modifiers="partial"> = {
    mechanic_type <json name="type"> <cs ignore="true">: status_effect_mechanic_type;
}

type status_effect_mechanic_hit_over_time <cs namespace="Octoio.Fey.Data.Dto" extends="StatusEffectMechanic" modifiers="partial"> = {
    mechanic_type <json name="type"> <cs ignore="true">: status_effect_mechanic_type;
    hit <cs usetype="Type.Hit">: hit_type;
    tick_rate: float <ocaml valid="Validation.float_min 0.1">;
}

(* How a Control status moves controllers while it lasts (the Chrono duration of the status effect is the time) *)
type status_control_mode <cs namespace="Octoio.Fey.Data.Type"> =
    [ Shuffle         (* the controllers of the afflicted characters rotate among them *)
    | SwapWithSource  (* the caster and the first afflicted character exchange controllers *)
    | Dominate        (* the caster takes control of the afflicted character; a player caster's own body idles *)
    ]

type status_effect_mechanic_control <cs namespace="Octoio.Fey.Data.Dto" extends="StatusEffectMechanic" modifiers="partial"> = {
    mechanic_type <json name="type"> <cs ignore="true">: status_effect_mechanic_type;
    mode <cs usetype="Type.StatusControlMode">: status_control_mode;
}

(* What a CrowdControl status takes away from the afflicted while it lasts. A slow is not one of these: it is a StatChange on MovementSpeedModifier (a percentage). *)
type crowd_control_effect <cs namespace="Octoio.Fey.Data.Type"> =
    [ Stun     (* cannot move or cast; a running cast is interrupted when it lands *)
    | Root     (* cannot move; casting is unaffected *)
    | Silence  (* cannot cast, a running cast is interrupted when it lands; movement is unaffected *)
    | Taunt    (* an AI-controlled afflicted character must attack the source of the status; it can still do everything *)
    ]

type status_effect_mechanic_crowd_control <cs namespace="Octoio.Fey.Data.Dto" extends="StatusEffectMechanic" modifiers="partial"> = {
    mechanic_type <json name="type"> <cs ignore="true">: status_effect_mechanic_type;
    effect <cs usetype="Type.CrowdControlEffect">: crowd_control_effect;
}

type status_stack_scaling_strategy <cs namespace="Octoio.Fey.Data.Type"> =
    [ Additive
    | Multiplicative
    ]

type status_stack <cs namespace="Octoio.Fey.Data.Dto"> = {
    size <cs usetype="uint">: int <ocaml valid="Validation.int_min 1">;
    scaling_strategy <cs usetype="Type.StatusStackScalingStrategy">: status_stack_scaling_strategy;
} 

type status <cs namespace="Octoio.Fey.Data.Dto"> = {
    metadata: metadata;
    mechanic <cs usetype="StatusEffectMechanic">: status_effect_mechanic_internal;
    stack: status_stack;
    (* effects that fire on something happening to the afflicted character while it has the status (see trigger.atd) *)
    ?triggers <cs usetype="Optional<Trigger[]>">: trigger list option <ocaml valid="Validation.validate_triggers">;
}
