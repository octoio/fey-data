type metadata <ocaml from="Common"> = abstract
type entity_reference <ocaml from="Common"> = abstract

(* An expedition is a chain of board quests of rising difficulty that ends in a boss; the party plays it as one run
   (fey-rs docs/design/runs.md sections 3 and 7). Data holds ids and numbers only. *)

(* One quest of the chain. The party plays one quest of [quests] per slot: the first and the last slot are fixed (drawn
   from the pool by the expedition seed, no vote), a middle slot offers two of the pool at the camp before it. The last
   slot is the boss slot: its quests must be played on hand-made stages. *)
type expedition_slot <cs namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;System.Collections.Generic"> = {
  quests <cs usetype="List<EntityReference>">: entity_reference list <ocaml valid="Validation.entity_reference_list_of_type 1 `Quest">;
  (* added to the level of every hostile spawned in the slot, on top of the tier the party chose *)
  level_bonus: int <ocaml valid="Validation.int_min 0">;
  (* added to the rarity tilt of every drop roll in the slot, on top of the tier *)
  loot_tilt: float <ocaml valid="Validation.float_min 0.">;
}

(* [camp] is the stage the party rests on between two quests. [xp_multiplier] (default 1) scales the experience earned
   inside the expedition: the lever that sets the level the party has when it reaches the boss. 3 to 5 slots. *)
type expedition_def <cs namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;System.Collections.Generic"> = {
  metadata: metadata;
  camp: entity_reference <ocaml valid="Validation.entity_reference_of_type `Stage">;
  slots <cs usetype="List<ExpeditionSlot>">: expedition_slot list <ocaml valid="Validation.expedition_slot_count">;
  ?xp_multiplier <cs usetype="Optional<float>">: float option <ocaml valid="Validation.float_min_if_some 0.1">;
} <ocaml valid="Validation.validate_expedition">
