type metadata <ocaml from="Common"> = abstract
type color <ocaml from="Common"> = abstract

type quality_type = 
    [ None
    | Common
    | Uncommon
    | Rare
    | Epic
    | Legendary
    ]

type quality = {
    metadata: metadata;
    quality_type <json name="type">: quality_type;
    color: color;
    text_color: color;
    text_over_color: color;
}
