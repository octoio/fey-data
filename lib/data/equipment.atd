type int_range <ocaml from="Common"> = abstract
type metadata <ocaml from="Common"> = abstract
type stat_affix <ocaml from="Affix"> = abstract
type quality_type <ocaml from="Quality"> = abstract
type entity_reference <ocaml from="Common"> = abstract
type trigger <ocaml from="Trigger"> = abstract
type visual_layer <ocaml from="Visual"> = abstract

type equipment_category = 
    [ Head
    | Eyes
    | Earings
    | FaceAccessory
    | Back
    | Neck
    | Shoulders
    | Bracers
    | Hands
    | Ring
    | Chest
    | Waist
    | Legs
    | Feet
    ]

type equipment = {
    metadata: metadata;
    category: equipment_category;
    quality: quality_type;
    icon_reference : entity_reference <ocaml valid="Validation.entity_reference_of_type `Image">;
    base_stat_affixes: stat_affix list;
    random_stat_affix_count: int_range <ocaml valid="Validation.int_range_between {min=0; max=100}">;
    random_stat_affixes: stat_affix list;
    (* effects that fire on something happening to the wearer while the item is worn (see trigger.atd) *)
    ?triggers: trigger list option <ocaml valid="Validation.validate_triggers">;
    (* character level needed to equip it; absent = any *)
    ?min_level: int option <ocaml valid="Validation.int_min_if_some 2">;
    (* the look layer shown for it, see visual.atd; it replaces the base layer of the category's slot *)
    ?visual: visual_layer option;
}
