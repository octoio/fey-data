type metadata <ocaml from="Common"> = abstract
type vector3 <ocaml from="Common"> = abstract
type float_range <ocaml from="Common"> = abstract
type xp_chart <ocaml from="Common"> = abstract
type hit_type <ocaml from="Common"> = abstract
type quality_type <ocaml from="Quality"> = abstract
type stat_type <ocaml from="Stat"> = abstract
type entity_reference <ocaml from="Common"> = abstract
type skill_vfx <ocaml from="Vfx"> = abstract
type trigger <ocaml from="Trigger"> = abstract
type status_duration <ocaml from="Effect"> = abstract
type requirement_evaluation <ocaml from="Requirement"> = abstract
type hit_effect <ocaml from="Effect"> = abstract
type status_effect <ocaml from="Effect"> = abstract
type effect_target_mechanic_internal <ocaml from="Effect"> = abstract
type effect_scaling <ocaml from="Effect"> = abstract
type effect_target <ocaml from="Effect"> = abstract
type character_team <ocaml from="Effect"> = abstract

type skill_category = 
  [ None
  | All
  | Offense
  | Defense
  | Utility
  | Healing
  | Control
  | Mobility
  ]

type skill_cost = {
  mana: int <ocaml valid="Validation.int_min 0">;
}

type skill_target_type = 
  [ Self
  | Ally
  | Enemy
  | Any
  | Position
  | None
  | DeadAlly  (* a dead teammate of the caster: the only skills that target a corpse, and they target nothing else *)
  ]

type projectile_spawn_position_type = 
  [ Character
  | World
  ]

type projectile_spawn_position = {
  position_type <json name="type">: projectile_spawn_position_type;
  position: vector3;
  offset: vector3;
}

type skill_action_node_type = 
  [ Sequence
  | Parallel
  | Delay
  | Animation
  | Sound
  | Hit
  | Status
  | Summon
  | Requirement
  | Projectile
  | Move
  | Interrupt
  ]

type skill_action_node = {
  skill_action_node_type <json name="type">: skill_action_node_type;
  name: string;
}

type skill_action_sequence_node = {
  skill_action_node_type <json name="type">: skill_action_node_type;
  name: string;
  children: skill_action_node_internal list;
  loop: int <ocaml valid="Validation.int_min 1">;
}

type skill_action_parallel_node = {
  skill_action_node_type <json name="type">: skill_action_node_type;
  name: string;
  children: skill_action_node_internal list;
  loop: int <ocaml valid="Validation.int_min 1">;
}

type skill_action_delay_node = {
  skill_action_node_type <json name="type">: skill_action_node_type;
  name: string;
  delay: float;
}

(* Gameplay timing vs presentation: [duration] and [show_progress] are GAMEPLAY timing (how long
   the action blocks the caster and whether a cast bar is shown). [animations] are PRESENTATION
   cues only (Fey-owned AnimationSource entities); the sim passes the refs through unchanged and
   each engine adapter decides what, if anything, to play. *)
type skill_action_animation_node = {
  skill_action_node_type <json name="type">: skill_action_node_type;
  name: string;
  show_progress: bool;
  duration: float <ocaml valid="Validation.float_min 0.">;
  animations: entity_reference list <ocaml valid="Validation.entity_reference_list_of_type 1 `AnimationSource">;
}

type skill_action_sound_node = {
    skill_action_node_type <json name="type">: skill_action_node_type;
    name: string;
    sound: entity_reference <ocaml valid="Validation.entity_reference_of_type `Sound">;
}

type skill_action_hit_effect_node = {
  skill_action_node_type <json name="type">: skill_action_node_type;
  name: string;
  hit_effect: hit_effect;
}

type skill_action_status_effect_node = {
  skill_action_node_type <json name="type">: skill_action_node_type;
  name: string;
  status_effect: status_effect;
}

type skill_action_summon_node = {
  skill_action_node_type <json name="type">: skill_action_node_type;
  name: string;
  summon_entity: entity_reference <ocaml valid="Validation.entity_reference_of_type `Character">;
  position_offset: vector3;
  (* Seconds the summon lives; absent = until it dies, its summoner dies or the stage changes *)
  ?lifetime: float option;
  (* How many summons of this entity one summoner may have alive; absent = unlimited *)
  ?max_alive: int option;
  (* The summoner steers the summon for its `lifetime` (which is then required) while its own body stands idle and vulnerable *)
  ?controlled: bool option;
} <ocaml valid="Validation.validate_summon_control">

type skill_action_requirement_node = {
  skill_action_node_type <json name="type">: skill_action_node_type;
  name: string;
  requirements: requirement_evaluation;
  child: skill_action_node_internal;
}

type skill_action_projectile_node = {
  skill_action_node_type <json name="type">: skill_action_node_type;
  name: string;
  projectile: entity_reference <ocaml valid="Validation.entity_reference_of_type `Projectile">;
  spawn_position: projectile_spawn_position;
  direction: vector3;
}

(* Movement of the caster (docs/systems/movement.md in fey-rs). [Dash] runs [distance] units towards the aimed
   ground point over [duration] seconds, through bodies, and ends outside them. [Blink] appears at the aimed ground
   point, at most [distance] units away. [ShadowStep] appears [distance] units behind the selected target (on the
   far side from the caster). [Swap] trades places with the selected character. The instant modes take no duration;
   Swap takes no distance *)
type skill_move_mode =
  [ Dash
  | Blink
  | ShadowStep
  | Swap
  ]

type skill_action_move_node = {
  skill_action_node_type <json name="type">: skill_action_node_type;
  name: string;
  mode: skill_move_mode;
  distance: float <ocaml valid="Validation.float_min 0.">;
  duration: float <ocaml valid="Validation.float_min 0.">;
} <ocaml valid="Validation.validate_move_node">

(* Cancels the running cast of each character the mechanic and team pick. The cost and cooldown of the target's
   cast are spent. Leaves no status behind, except [on_interrupt]: a status applied to each character whose cast
   was really cancelled (an idle one is untouched). Its target mechanic must be Selected, which stands for the
   interrupted character *)
type skill_action_interrupt_node = {
  skill_action_node_type <json name="type">: skill_action_node_type;
  name: string;
  target_mechanic: effect_target_mechanic_internal;
  target: effect_target;
  ?on_interrupt: status_effect option;
} <ocaml valid="Validation.validate_interrupt_node">

type skill_action_node_internal = 
  [ Sequence of skill_action_sequence_node
  | Parallel of skill_action_parallel_node
  | Delay of skill_action_delay_node
  | Animation of skill_action_animation_node
  | Sound of skill_action_sound_node
  | Hit of skill_action_hit_effect_node
  | Status of skill_action_status_effect_node
  | Summon of skill_action_summon_node
  | Requirement of skill_action_requirement_node
  | Projectile of skill_action_projectile_node
  | Move of skill_action_move_node
  | Interrupt of skill_action_interrupt_node
  ] <json adapter.ocaml="Atdgen_runtime.Json_adapter.Type_field">

type skill_indicator_position = 
  [ Character
  | Mouse
  | FromCharacterToMouse
  ]
 
type skill_indicator <ocaml attr="deriving eq,show"> = {
  model_reference: entity_reference <ocaml valid="Validation.entity_reference_of_type `Model">;
  position: skill_indicator_position;
  scale: vector3;
}

(* Skill progression: a skill earns [xp_per_use] XP for its caster each time a cast of it completes;
   levels follow [chart]. A skill without this table earns no XP. Each level above 1 makes the skill's Damage and Heal
   hits [power_per_level] stronger (default 0.05) and its cooldown [cooldown_per_level] shorter (default 0.01),
   counting at most 10 levels above 1 (so at most +50% power and -10% cooldown by default). *)
type skill_experience = {
  xp_per_use: float <ocaml valid="Validation.float_min 0.">;
  chart: xp_chart;
  ?max_level: int option;
  ?power_per_level: float option <ocaml valid="Validation.validate_growth">;
  ?cooldown_per_level: float option <ocaml valid="Validation.validate_cooldown_per_level">;
}

type skill = {
  metadata: metadata;
  quality: quality_type;
  icon_reference : entity_reference <ocaml valid="Validation.entity_reference_of_type `Image">;
  categories: skill_category list;
  cost: skill_cost;
  cooldown: float;
  target_type: skill_target_type;
  execution_root: skill_action_requirement_node;
  cast_distance: float_range;
  indicators: skill_indicator list;
  ?experience: skill_experience option;
  (* true: the caster may walk while this skill is cast and the cast runs on (movement skills); absent = a move input
     before the cast window ends cancels the cast, mana and cooldown coming back when nothing has landed
     (docs/design/skill-audit.md in fey-rs). The cast window runs from the start of the cast to the end of its last
     Animation node (to the end of the tree when it has none), so a zone that keeps burning after the cast is not
     part of it. *)
  ?walk_while_casting: bool option;
  (* true: the skill may be cast while another cast runs, and cancels that cast (a dash out of a cast) *)
  ?cancels_cast: bool option;
  (* charges the cooldown refills one at a time; absent = 1. A cast spends one charge, so a skill with 2 charges can
     be cast twice in a row and then every [cooldown] seconds *)
  ?charges: int option <ocaml valid="Validation.validate_charges">;
  (* effects that fire on something happening to a character that knows the skill (see trigger.atd) *)
  ?triggers: trigger list option <ocaml valid="Validation.validate_triggers">;
  (* seconds from the start of the cast to the hit, for skills with an attack cue: the client plays the attack clip at
     the rate (clip impact time / hit_delay) so the hit lands with the simulation's. Absent: the client's default *)
  ?hit_delay: float option <ocaml valid="Validation.float_min_if_some 0.05">;
  (* visual effects by phase (see vfx.atd); presentation only *)
  ?vfx: skill_vfx option;
}
