type metadata <ocaml from="Common"> = abstract
type color <ocaml from="Common"> = abstract
type entity_reference <ocaml from="Common"> = abstract
type zone_type <ocaml from="Common"> = abstract
type character_type <ocaml from="Character"> = abstract
type stage_type <ocaml from="Stage"> = abstract
type portal_type <ocaml from="Stage"> = abstract
type achievement_type <ocaml from="Achievement"> = abstract
type spawn_sequence <ocaml from="Spawn"> = abstract

type quest_difficulty_type <cs name="QuestDifficulty" namespace="Octoio.Fey.Data.Type"> =
  [ Easy
  | Normal
  | Hard
  | Insane
  | Impossible
  ]

type quest_difficulty <cs namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;UnityEngine;Octoio.Fey.Data.Type"> = {
  metadata: metadata;
  difficulty_type <json name="type"> <cs usetype="Type.QuestDifficulty">: quest_difficulty_type;
  color: color;
}

type quest_origin <cs namespace="Octoio.Fey.Data.Type"> =
  [ QuestBoard
  | Item
  | NPC
  | World
  | Stage
  | Quest
  | Event
  | Player
  ]

type quest_assignee <cs namespace="Octoio.Fey.Data.Type"> =
  [ Player
  | Team
  | PlayerHidden
  | TeamHidden
  ]

(* Objective requirements *)

type quest_objective_requirement_type <cs name="QuestObjectiveRequirement" namespace="Octoio.Fey.Data.Type"> =
  [ Collect
  | KillSpecific
  | Activate
  | Charge
  | PickQuest
  | Teleport
  | EnterZone
  | StayInZone
  ]

(* amount: how much of the requirement must be completed. Negative values mean ALL *)
type quest_objective_requirement <cs namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type" modifiers="abstract,partial"> = {
  requirement_type <json name="type"> <cs usetype="Type.QuestObjectiveRequirement">: quest_objective_requirement_type;
  metadata: metadata;
  amount: float;
}

type quest_objective_requirement_collect <cs extends="QuestObjectiveRequirement" namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type" modifiers="partial"> = {
  requirement_type <json name="type"> <cs ignore="true">: quest_objective_requirement_type;
  metadata <cs ignore="true">: metadata;
  amount <cs ignore="true">: float;
}

type quest_objective_requirement_kill_specific <cs extends="QuestObjectiveRequirement" namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type;System.Collections.Generic" modifiers="partial"> = {
  requirement_type <json name="type"> <cs ignore="true">: quest_objective_requirement_type;
  metadata <cs ignore="true">: metadata;
  amount <cs ignore="true">: float;
  character_types <cs usetype="List<Type.Character>">: character_type list <ocaml valid="Validation.list_min_length 1">;
}

type quest_objective_requirement_activate <cs extends="QuestObjectiveRequirement" namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type" modifiers="partial"> = {
  requirement_type <json name="type"> <cs ignore="true">: quest_objective_requirement_type;
  metadata <cs ignore="true">: metadata;
  amount <cs ignore="true">: float;
}

type quest_objective_requirement_charge <cs extends="QuestObjectiveRequirement" namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type" modifiers="partial"> = {
  requirement_type <json name="type"> <cs ignore="true">: quest_objective_requirement_type;
  metadata <cs ignore="true">: metadata;
  amount <cs ignore="true">: float;
}

type quest_objective_requirement_pick_quest <cs extends="QuestObjectiveRequirement" namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type" modifiers="partial"> = {
  requirement_type <json name="type"> <cs ignore="true">: quest_objective_requirement_type;
  metadata <cs ignore="true">: metadata;
  amount <cs ignore="true">: float;
}

type quest_objective_requirement_teleport <cs extends="QuestObjectiveRequirement" namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type" modifiers="partial"> = {
  requirement_type <json name="type"> <cs ignore="true">: quest_objective_requirement_type;
  metadata <cs ignore="true">: metadata;
  amount <cs ignore="true">: float;
}

type quest_objective_requirement_enter_zone <cs extends="QuestObjectiveRequirement" namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type;System.Collections.Generic" modifiers="partial"> = {
  requirement_type <json name="type"> <cs ignore="true">: quest_objective_requirement_type;
  metadata <cs ignore="true">: metadata;
  amount <cs ignore="true">: float;
  zone_types <cs usetype="List<Type.Zone>">: zone_type list <ocaml valid="Validation.list_min_length 1">;
}

type quest_objective_requirement_stay_in_zone <cs extends="QuestObjectiveRequirement" namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type;System.Collections.Generic" modifiers="partial"> = {
  requirement_type <json name="type"> <cs ignore="true">: quest_objective_requirement_type;
  metadata <cs ignore="true">: metadata;
  amount <cs ignore="true">: float;
  zone_types <cs usetype="List<Type.Zone>">: zone_type list <ocaml valid="Validation.list_min_length 1">;
}

type quest_objective_requirement_internal <cs generators="visitor(namespace=Octoio.Fey.Data.Dto,nameprefix=QuestObjectiveRequirement),converter(namespace=Octoio.Fey.Data.Mapper,nameprefix=QuestObjectiveRequirement,enumname=Type.QuestObjectiveRequirement)"> =
  [ Collect of quest_objective_requirement_collect
  | KillSpecific of quest_objective_requirement_kill_specific
  | Activate of quest_objective_requirement_activate
  | Charge of quest_objective_requirement_charge
  | PickQuest of quest_objective_requirement_pick_quest
  | Teleport of quest_objective_requirement_teleport
  | EnterZone of quest_objective_requirement_enter_zone
  | StayInZone of quest_objective_requirement_stay_in_zone
  ] <json adapter.ocaml="Atdgen_runtime.Json_adapter.Type_field">

(* Completion results *)

type quest_completion_result_type <cs name="QuestCompletionResult" namespace="Octoio.Fey.Data.Type"> =
  [ Spawn
  | ActivatePortal
  | EnableQuestBoardQuest
  | ActivateZone
  | DeactivateZone
  | StartSpawnSequence
  ]

type quest_completion_result_activate_portal_type <cs name="QuestCompletionResultActivatePortal" namespace="Octoio.Fey.Data.Type"> =
  [ BackToTheVillage
  | QuestBoardQuestStage
  ]

type quest_completion_result <cs namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type" modifiers="abstract,partial"> = {
  result_type <json name="type"> <cs usetype="Type.QuestCompletionResult">: quest_completion_result_type;
  message: string;
}

type quest_completion_result_spawn <cs extends="QuestCompletionResult" namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type;System.Collections.Generic" modifiers="partial"> = {
  result_type <json name="type"> <cs ignore="true">: quest_completion_result_type;
  message <cs ignore="true">: string;
  characters: entity_reference list <ocaml valid="Validation.entity_reference_list_of_type 1 `Character">;
}

type quest_completion_result_activate_portal <cs extends="QuestCompletionResult" namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type" modifiers="partial"> = {
  result_type <json name="type"> <cs ignore="true">: quest_completion_result_type;
  message <cs ignore="true">: string;
  activate_portal_type <cs usetype="Type.QuestCompletionResultActivatePortal">: quest_completion_result_activate_portal_type;
  portal_type <cs usetype="Type.Portal">: portal_type;
}

type quest_completion_result_enable_quest_board_quest <cs extends="QuestCompletionResult" namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type" modifiers="partial"> = {
  result_type <json name="type"> <cs ignore="true">: quest_completion_result_type;
  message <cs ignore="true">: string;
}

type quest_completion_result_activate_zone <cs extends="QuestCompletionResult" namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type" modifiers="partial"> = {
  result_type <json name="type"> <cs ignore="true">: quest_completion_result_type;
  message <cs ignore="true">: string;
  zone_type <cs usetype="Type.Zone">: zone_type;
}

type quest_completion_result_deactivate_zone <cs extends="QuestCompletionResult" namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type" modifiers="partial"> = {
  result_type <json name="type"> <cs ignore="true">: quest_completion_result_type;
  message <cs ignore="true">: string;
  zone_type <cs usetype="Type.Zone">: zone_type;
}

type quest_completion_result_start_spawn_sequence <cs extends="QuestCompletionResult" namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type" modifiers="partial"> = {
  result_type <json name="type"> <cs ignore="true">: quest_completion_result_type;
  message <cs ignore="true">: string;
  spawn_sequence: spawn_sequence;
}

type quest_completion_result_internal <cs generators="visitor(namespace=Octoio.Fey.Data.Dto,nameprefix=QuestCompletionResult),converter(namespace=Octoio.Fey.Data.Mapper,nameprefix=QuestCompletionResult,enumname=Type.QuestCompletionResult)"> =
  [ Spawn of quest_completion_result_spawn
  | ActivatePortal of quest_completion_result_activate_portal
  | EnableQuestBoardQuest of quest_completion_result_enable_quest_board_quest
  | ActivateZone of quest_completion_result_activate_zone
  | DeactivateZone of quest_completion_result_deactivate_zone
  | StartSpawnSequence of quest_completion_result_start_spawn_sequence
  ] <json adapter.ocaml="Atdgen_runtime.Json_adapter.Type_field">

(* Quest structure *)

type quest_objective <cs namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type;System.Collections.Generic"> = {
  metadata: metadata;
  is_optional: bool;
  requirements <cs usetype="List<QuestObjectiveRequirement>">: quest_objective_requirement_internal list <ocaml valid="Validation.list_min_length 1">;
}

type quest_step <cs namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type;System.Collections.Generic"> = {
  objectives: quest_objective list <ocaml valid="Validation.list_min_length 1">;
  completion_results <cs usetype="List<QuestCompletionResult>">: quest_completion_result_internal list;
}

type quest <cs namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System;Octoio.Fey.Data.Type;System.Collections.Generic"> = {
  metadata: metadata;
  origin <cs usetype="Type.QuestOrigin">: quest_origin;
  assignee <cs usetype="Type.QuestAssignee">: quest_assignee;
  difficulty: entity_reference <ocaml valid="Validation.entity_reference_of_type `QuestDifficulty">;
  steps: quest_step list <ocaml valid="Validation.list_min_length 1">;
  stage_to_go_from_quest_board <cs usetype="Type.Stage">: stage_type;
  is_repeatable: bool;
  achievement_on_complete <cs usetype="Type.Achievement">: achievement_type;
  required_achievements <cs usetype="List<Type.Achievement>">: achievement_type list <ocaml valid="Validation.list_min_length 1">;
  start_results <cs usetype="List<QuestCompletionResult>">: quest_completion_result_internal list;
}
