type metadata <ocaml from="Common"> = abstract
type color <ocaml from="Common"> = abstract
type entity_reference <ocaml from="Common"> = abstract
type character_type <ocaml from="Character"> = abstract
type achievement_type <ocaml from="Achievement"> = abstract
type stat_type <ocaml from="Stat"> = abstract
type monster_rank <ocaml from="Character"> = abstract
type quality_type <ocaml from="Quality"> = abstract
type spawn <ocaml from="Spawn"> = abstract
type spawn_sequence <ocaml from="Spawn"> = abstract

type quest_difficulty_type =
  [ Easy
  | Normal
  | Hard
  | Insane
  | Impossible
  | Nightmare
  ]

(* A monster modifier of a tier: the final value of [stat] is multiplied by [multiplier] (1.3 = +30%,
   0.8 = -20%) for every hostile spawned while the tier is active. [min_rank] limits it to monsters
   of that rank or above (a boss-only affix). Affixes on the same stat add their deltas. *)
type tier_affix = {
  name: string <ocaml valid="Validation.string_min_length 1">;
  stat: stat_type;
  multiplier: float <ocaml valid="Validation.float_min 0.05">;
  ?min_rank: monster_rank option;
}

(* What a difficulty entity changes when it is offered as a tier of the quest board (a quest is offered
   once per difficulty that has a tier, in [order]). The tier with the lowest order is the base: it
   must change nothing (no bonus, affix, extra adds, tilt or multiplier). Semantics: fey-rs
   docs/systems/tiers.md. *)
type quest_tier = {
  (* position on the board, unique among tiers; the board offers a quest once per tier *)
  order: int <ocaml valid="Validation.int_min 0">;
  (* added to the level of every hostile spawned (default 0): raises the rarity tilt and the gates *)
  ?level_bonus: int option <ocaml valid="Validation.int_min_if_some 0">;
  (* extra Normal-rank adds: scripted spawns of normal monsters count (1 + extra_adds) times, rounded
     to the nearest whole number (default 0) *)
  ?extra_adds: float option <ocaml valid="Validation.float_min_if_some 0.">;
  ?affixes: tier_affix list option;
  (* added to the rarity tilt of every drop roll (default 0) *)
  ?rarity_tilt: float option <ocaml valid="Validation.float_min_if_some 0.">;
  (* raises the rarity every drop guarantee demands to at least this *)
  ?guarantee_min_quality: quality_type option <ocaml valid="Validation.validate_guarantee_quality_if_some">;
  (* multiplies the gold of every drop (default 1) *)
  ?gold_multiplier: float option <ocaml valid="Validation.float_min_if_some 0.1">;
}

type quest_difficulty = {
  metadata: metadata;
  difficulty_type <json name="type">: quest_difficulty_type;
  color: color;
  (* absent: the quest board never offers this difficulty *)
  ?tier: quest_tier option;
}

type quest_origin =
  [ QuestBoard
  | Item
  | NPC
  | World
  | Stage
  | Quest
  | Event
  | Player
  ]

type quest_assignee =
  [ Player
  | Team
  | PlayerHidden
  | TeamHidden
  ]

(* Conditions: single event-driven checks tracked by the server.
   Combining conditions is the tree's job (Parallel/Any/Sequence). *)

type quest_condition_type =
  [ KillSpecific
  | EnterAnchor
  | StayInAnchor
  | PickQuest
  | Teleport
  | Interact
  | Channel
  ]

type quest_condition = {
  condition_type <json name="type">: quest_condition_type;
}

type quest_condition_kill_specific = {
  condition_type <json name="type">: quest_condition_type;
  character_types: character_type list <ocaml valid="Validation.list_min_length 1">;
  (* when set, only kills of this character definition count (the type must still match) *)
  ?character: entity_reference option <ocaml valid="Validation.entity_reference_of_type_if_some `Character">;
  amount: int <ocaml valid="Validation.int_min 1">;
}

(* amount: characters required inside the anchor; negative means all players *)
type quest_condition_enter_anchor = {
  condition_type <json name="type">: quest_condition_type;
  anchor: entity_reference <ocaml valid="Validation.entity_reference_of_type `Anchor">;
  amount: float;
}

type quest_condition_stay_in_anchor = {
  condition_type <json name="type">: quest_condition_type;
  anchor: entity_reference <ocaml valid="Validation.entity_reference_of_type `Anchor">;
  duration: float <ocaml valid="Validation.float_min 0.1">;
}

(* [quest]: only picking that quest completes the objective; absent = any pick *)
type quest_condition_pick_quest = {
  condition_type <json name="type">: quest_condition_type;
  ?quest: entity_reference option <ocaml valid="Validation.entity_reference_of_type_if_some `Quest">;
}

(* [stage]: only arriving on that stage completes the objective; absent = arriving on any stage other
   than the one the objective started on *)
type quest_condition_teleport = {
  condition_type <json name="type">: quest_condition_type;
  ?stage: entity_reference option <ocaml valid="Validation.entity_reference_of_type_if_some `Stage">;
}

(* A living party player standing in the anchor's zone uses it (the Interact input): a lever, a chest,
   an NPC. The anchor must be an active Zone of the quest's stage; the interaction counts once. *)
type quest_condition_interact = {
  condition_type <json name="type">: quest_condition_type;
  anchor: entity_reference <ocaml valid="Validation.entity_reference_of_type `Anchor">;
}

(* A channelled interaction: a living party player stands within the zone of one of [anchors] (the
   Interact input) and channels [seconds] without moving, casting or being hurt, like the revive
   channel. An anchor is freed once; the objective is done when [amount] of them are (more than
   there are: all). When a channel starts, [spawns] appear (the spiders that drop on the webbed
   travellers). With [raises_stone], each anchor freed raises one skill of the offer of the quest's
   completion stone by one rarity step, up to Rare. *)
type quest_condition_channel = {
  condition_type <json name="type">: quest_condition_type;
  anchors: entity_reference list <ocaml valid="Validation.entity_reference_list_of_type 1 `Anchor">;
  amount: int <ocaml valid="Validation.int_min 1">;
  seconds: float <ocaml valid="Validation.float_min 0.5">;
  spawns: spawn list;
  raises_stone: bool;
}

type quest_condition_internal =
  [ KillSpecific of quest_condition_kill_specific
  | EnterAnchor of quest_condition_enter_anchor
  | StayInAnchor of quest_condition_stay_in_anchor
  | PickQuest of quest_condition_pick_quest
  | Teleport of quest_condition_teleport
  | Interact of quest_condition_interact
  | Channel of quest_condition_channel
  ] <json adapter.ocaml="Atdgen_runtime.Json_adapter.Type_field">

(* Actions: fire-and-forget world mutations (no rollback) *)

type quest_action_type =
  [ Spawn
  | StartSpawnSequence
  | ActivateAnchor
  | DeactivateAnchor
  | ActivatePortalToStage
  | ActivatePortalToQuestStage
  | Message
  | EnableQuestBoardQuest
  | StartEscalation
  | SpawnAtRemains
  ]

type quest_action = {
  action_type <json name="type">: quest_action_type;
}

type quest_action_spawn = {
  action_type <json name="type">: quest_action_type;
  spawn: spawn;
}

type quest_action_start_spawn_sequence = {
  action_type <json name="type">: quest_action_type;
  spawn_sequence: spawn_sequence;
}

type quest_action_activate_anchor = {
  action_type <json name="type">: quest_action_type;
  anchor: entity_reference <ocaml valid="Validation.entity_reference_of_type `Anchor">;
}

type quest_action_deactivate_anchor = {
  action_type <json name="type">: quest_action_type;
  anchor: entity_reference <ocaml valid="Validation.entity_reference_of_type `Anchor">;
}

type quest_action_activate_portal_to_stage = {
  action_type <json name="type">: quest_action_type;
  anchor: entity_reference <ocaml valid="Validation.entity_reference_of_type `Anchor">;
  destination: entity_reference <ocaml valid="Validation.entity_reference_of_type `Stage">;
}

(* Destination resolved at runtime: the stage of the pending quest board quest *)
type quest_action_activate_portal_to_quest_stage = {
  action_type <json name="type">: quest_action_type;
  anchor: entity_reference <ocaml valid="Validation.entity_reference_of_type `Anchor">;
}

type quest_action_message = {
  action_type <json name="type">: quest_action_type;
  message: string <ocaml valid="Validation.string_min_length 1">;
}

type quest_action_enable_quest_board_quest = {
  action_type <json name="type">: quest_action_type;
}

(* The nests breed: while any living character of [nest] stands, they spawn one [spawn] each [interval] seconds
   between them (a standing nest makes one per interval; a bred monster stays at the nest that bred it, in its area),
   never more than [cap] alive per nest. Breaking a nest stops its share. The numbers are a spawn budget that grows
   with time (fey-rs docs/systems/quests.md, "Escalation"). The escalation ends with the stage. The [spawn]
   monsters give XP and loot only when [rewards]: a quest that punishes slowness must not become a farm. *)
type quest_action_start_escalation = {
  action_type <json name="type">: quest_action_type;
  nest: entity_reference <ocaml valid="Validation.entity_reference_of_type `Character">;
  spawn: entity_reference <ocaml valid="Validation.entity_reference_of_type `Character">;
  interval: float <ocaml valid="Validation.float_min 1.">;
  cap: int <ocaml valid="Validation.int_min 1">;
  rewards: bool;
}

(* [character] rises where the latest dead [remains_of] character fell (its body is still on the stage) *)
type quest_action_spawn_at_remains = {
  action_type <json name="type">: quest_action_type;
  character: entity_reference <ocaml valid="Validation.entity_reference_of_type `Character">;
  remains_of: entity_reference <ocaml valid="Validation.entity_reference_of_type `Character">;
  target_adventurer_on_spawn: bool;
}

type quest_action_internal =
  [ Spawn of quest_action_spawn
  | StartSpawnSequence of quest_action_start_spawn_sequence
  | ActivateAnchor of quest_action_activate_anchor
  | DeactivateAnchor of quest_action_deactivate_anchor
  | ActivatePortalToStage of quest_action_activate_portal_to_stage
  | ActivatePortalToQuestStage of quest_action_activate_portal_to_quest_stage
  | Message of quest_action_message
  | EnableQuestBoardQuest of quest_action_enable_quest_board_quest
  | StartEscalation of quest_action_start_escalation
  | SpawnAtRemains of quest_action_spawn_at_remains
  ] <json adapter.ocaml="Atdgen_runtime.Json_adapter.Type_field">

(* Execution tree — mirrors the skill action node pattern.
   Node ids are explicit, unique within a quest, and name nodes in network records;
   they survive data edits (future hot reload). The console auto-assigns them. *)

type quest_node_type =
  [ Sequence
  | Parallel
  | Any
  | Timer
  | Objective
  | Action
  ]

(* Restart cancels the child subtree and starts it and the timer again: a wave that repeats until beaten *)
type quest_timer_timeout_type =
  [ Fail
  | Complete
  | Restart
  ]

type quest_node = {
  node_type <json name="type">: quest_node_type;
  id: int <ocaml valid="Validation.int_between 0 65535">;
  name: string;
}

(* Optional (any Parallel child): [optional] marks a child the Parallel does not wait for (on an Objective it is
   [is_optional]); it is an error outside a direct child of a Parallel. [bonus_achievement] (optional nodes only) is
   granted to the party when the quest completes with that node completed. Semantics: fey-rs
   docs/systems/quests.md. *)
type quest_sequence_node = {
  node_type <json name="type">: quest_node_type;
  id: int;
  name: string;
  ?optional: bool option;
  ?bonus_achievement: achievement_type option;
  children: quest_node_internal list <ocaml valid="Validation.list_min_length 1">;
}

type quest_parallel_node = {
  node_type <json name="type">: quest_node_type;
  id: int;
  name: string;
  ?optional: bool option;
  ?bonus_achievement: achievement_type option;
  children: quest_node_internal list <ocaml valid="Validation.list_min_length 1">;
}

(* First child to complete wins; losing branches are cancelled without rollback *)
type quest_any_node = {
  node_type <json name="type">: quest_node_type;
  id: int;
  name: string;
  ?optional: bool option;
  ?bonus_achievement: achievement_type option;
  children: quest_node_internal list <ocaml valid="Validation.list_min_length 1">;
}

type quest_timer_node = {
  node_type <json name="type">: quest_node_type;
  id: int;
  name: string;
  ?optional: bool option;
  ?bonus_achievement: achievement_type option;
  duration: float <ocaml valid="Validation.float_min 0.1">;
  child: quest_node_internal;
  on_timeout: quest_timer_timeout_type;
}

type quest_objective_node = {
  node_type <json name="type">: quest_node_type;
  id: int;
  name: string;
  metadata: metadata;
  is_optional: bool;
  ?bonus_achievement: achievement_type option;
  condition: quest_condition_internal;
}

type quest_action_node = {
  node_type <json name="type">: quest_node_type;
  id: int;
  name: string;
  action: quest_action_internal;
}

type quest_node_internal =
  [ Sequence of quest_sequence_node
  | Parallel of quest_parallel_node
  | Any of quest_any_node
  | Timer of quest_timer_node
  | Objective of quest_objective_node
  | Action of quest_action_node
  ] <json adapter.ocaml="Atdgen_runtime.Json_adapter.Type_field">

type quest = {
  metadata: metadata;
  origin: quest_origin;
  assignee: quest_assignee;
  difficulty: entity_reference <ocaml valid="Validation.entity_reference_of_type `QuestDifficulty">;
  stage: entity_reference <ocaml valid="Validation.entity_reference_of_type `Stage">;
  root: quest_node_internal;
  is_repeatable: bool;
  achievement_on_complete: achievement_type;
  (* the board offers the quest to a party whose every member owns ANY ONE of these (None is no requirement).
     The flags are run state: they are granted by clearing a quest and start over with the run (fey-rs
     docs/design/runs.md) *)
  required_achievements: achievement_type list <ocaml valid="Validation.list_min_length 1">;
  (* absent = false: clearing this quest ends the run as a win (the party goes home with the starting kit and
     the quest chain starts over). At least one board quest must end the run and be reachable from the start *)
  ?ends_run: bool option;
} <ocaml valid="Validation.validate_quest">
