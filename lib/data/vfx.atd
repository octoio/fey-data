(* Visual effects named by skills, projectiles and statuses (presentation only: the simulation never reads
   them). An effect is named by a key such as "fire/gather" or "frost/bolt": lowercase words joined by "-",
   groups joined by "/". The client owns the recipe behind each key (which masks and meshes of its asset packs,
   how they move and fade) and tints it with the element's colour, so the data carries no licensed content and
   no colours. A key the client does not know draws nothing. *)

type vfx_element =
  [ Physical
  | Fire
  | Frost
  | Arcane
  | Poison
  | Holy
  | Heal
  | Nature
  | Void
  ]

(* Effects of a skill, by phase. [element] is the colour family of every effect of the skill (hit sparks and cast
   glow included). Each key is optional.
   - [cast]: on the caster from the start of the cast until it lands (loops for the cast time)
   - [release]: on the caster at the landing tick (a dash or blink: at the point it left from)
   - [impact]: on every character this skill hits (a blink or dash: at the arrival point)
   - [area]: on the ground over the telegraphed area when it lands (centre and radius of the telegraph) *)
type skill_vfx = {
  element: vfx_element;
  ?cast: string option <ocaml valid="Validation.vfx_key_if_some">;
  ?release: string option <ocaml valid="Validation.vfx_key_if_some">;
  ?impact: string option <ocaml valid="Validation.vfx_key_if_some">;
  ?area: string option <ocaml valid="Validation.vfx_key_if_some">;
}

(* Effects of a projectile (coloured by the element of the skill that fired it). [body] rides the projectile,
   [trail] streams behind it, [impact] plays where it hits a body or lands. *)
type projectile_vfx = {
  ?body: string option <ocaml valid="Validation.vfx_key_if_some">;
  ?trail: string option <ocaml valid="Validation.vfx_key_if_some">;
  ?impact: string option <ocaml valid="Validation.vfx_key_if_some">;
}

(* The effect on a character while it has the status (from StatusApplied until StatusEnded). *)
type status_vfx = {
  element: vfx_element;
  effect: string <ocaml valid="Validation.vfx_key">;
}
