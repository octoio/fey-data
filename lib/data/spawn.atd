type entity_reference <ocaml from="Common"> = abstract

(* [assault]: the spawned monsters carry an order: they go for the nearest living character of that definition (they
   know where it is: no sight, no aggro radius, no leash home while one lives) and attack it with their normal kit.
   The usual rules still win: a taunt, a party member who hit them or stands in their aggro reach takes them first,
   and when that ends they go back to the order, never home. It cannot be combined with
   [target_adventurer_on_spawn] (fey-rs docs/systems/ai.md, "Assault"). *)
type spawn = {
  spawn_count: int <ocaml valid="Validation.int_min 1">;
  character: entity_reference <ocaml valid="Validation.entity_reference_of_type `Character">;
  anchor: entity_reference <ocaml valid="Validation.entity_reference_of_type `Anchor">;
  target_adventurer_on_spawn: bool;
  ?assault: entity_reference option <ocaml valid="Validation.entity_reference_of_type_if_some `Character">;
} <ocaml valid="Validation.validate_spawn">

type spawn_sequence_step = {
  timing: float <ocaml valid="Validation.float_between 0. 1.">;
  spawns: spawn list <ocaml valid="Validation.list_min_length 1">;
}

type spawn_sequence = {
  duration: float <ocaml valid="Validation.float_between 1. 300.">;
  steps: spawn_sequence_step list <ocaml valid="Validation.validate_spawn_sequence_steps">;
}
