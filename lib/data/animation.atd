type metadata <ocaml from="Common"> = abstract
type entity_reference <ocaml from="Common"> = abstract

(* Fey-owned, engine-agnostic presentation cues. A cue names WHAT should be
   shown; which clip/rig plays it is decided by each engine's adapter, never by
   data. [variant] selects one of several alternatives for the same cue
   (0-based; adapters wrap or clamp when they own fewer clips). *)
type animation_cue <cs name="AnimationCue" namespace="Octoio.Fey.Data.Type"> =
  [ AttackGeneric
  | AttackUnarmed
  | AttackStab
  | AttackSlash
  | AttackThrust
  | AttackCrush
  | AttackWand
  | AttackShield
  | AttackDual
  | AttackTwoHandSlash
  | AttackTwoHandChop
  | AttackTwoHandThrust
  | AttackTwoHandStaff
  | CastBuff
  | CastArea
  | CastSummon
  | CastAttack
  | CastChannel
  | HitBlocked
  ]

type animation_source <cs namespace="Octoio.Fey.Data.Dto" attributes="[Serializable]" imports="System" modifiers="partial"> = {
  cue <cs usetype="Type.AnimationCue">: animation_cue;
  variant: int <ocaml valid="Validation.int_min 0">;
  original_duration: float <ocaml valid="Validation.float_min 0.">;
  looping: bool;
  requires_sheath_weapon: bool;
}

type animation <cs namespace="Octoio.Fey.Data.Dto"> = {
  metadata: metadata;
  duration: float <ocaml valid="Validation.float_min 0.">;
  sources: entity_reference list <ocaml valid="Validation.entity_reference_list_of_type 0 `AnimationSource">;
}
