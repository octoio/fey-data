type int_range <ocaml from="Common"> = abstract
type metadata <ocaml from="Common"> = abstract
type entity_reference <ocaml from="Common"> = abstract
type stat_affix <ocaml from="Affix"> = abstract
type quality_type <ocaml from="Quality"> = abstract
type model_anchor_set <ocaml from="Model"> = abstract
type visual_layer <ocaml from="Visual"> = abstract

type weapon_category = 
    [ None
    | OneHandMace
    | TwoHandMace
    | OneHandAxe
    | TwoHandAxe
    | OneHandSword
    | TwoHandSword
    | Dagger
    | Fist
    | Bow
    | Staff
    | Wand
    | Shield
    | Spear
    ]

type weapon_equip_index =
    [ MainHand
    | OffHand
    | TwoHand
    ]

type weapon_sheathe_location = 
    [ Hips
    | Back
    ]

type weapon = {
    metadata: metadata;
    category: weapon_category;
    (* which equip slot the weapon occupies; explicit data, not derived from the category *)
    hand: weapon_equip_index;
    quality: quality_type;
    sheathe_location: weapon_sheathe_location;
    icon_reference : entity_reference <ocaml valid="Validation.entity_reference_of_type `Image">;
    base_stat_affixes: stat_affix list;
    random_stat_affix_count: int_range <ocaml valid="Validation.int_range_between {min=0; max=100}">;
    random_stat_affixes: stat_affix list;
    ?basic_attack: entity_reference option <ocaml valid="Validation.entity_reference_of_type_if_some `Skill">;
    model_anchor_set: model_anchor_set;
    (* character level needed to equip it; absent = any *)
    ?min_level: int option <ocaml valid="Validation.int_min_if_some 2">;
    (* the weapon class whose animation set it uses, when not the one listing its category (a spear thrust with a sword category) *)
    ?weapon_class: entity_reference option <ocaml valid="Validation.entity_reference_of_type_if_some `WeaponClass">;
    (* the look layer shown for it, see visual.atd; socket absent = the socket of [hand] (Sheathed: of [sheathe_location]) *)
    ?visual: visual_layer option;
}
