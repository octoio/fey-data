type metadata <ocaml from="Common"> = abstract
type transform <ocaml from="Common"> = abstract
type color <ocaml from="Common"> = abstract
type character_team <ocaml from="Effect"> = abstract
type anchor_binding <ocaml from="Generator"> = abstract
type rarity_weights <ocaml from="Drop"> = abstract
type entity_reference <ocaml from="Common"> = abstract
type quality_type <ocaml from="Quality"> = abstract

type anchor_type =
  [ Zone
  | SpawnPoint
  | Portal
  | QuestBoard
  | LampPost
  | HealingShrine
  | Lever
  | Merchant
  | Chest
  ]

type zone_detection_type =
  [ Overlap
  | Trigger
  ]

(* Gameplay markers owned by a stage; transforms are world space *)
type anchor = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  (* On a stage with a generator: which generated slot this anchor is; see [anchor_binding] *)
  ?binding: anchor_binding option;
}

(* [models] = the keys of the pack props a zone can stand as (a cocoon): the sim picks one per run from the run seed
   and the anchor's binding ordinal, so the zones of a slot rotate through the list and differ. Absent = a bare disc *)
type anchor_zone = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  ?binding: anchor_binding option;
  ?models: string list option <ocaml valid="Validation.validate_model_keys_if_some">;
  detection: zone_detection_type;
  radius: float <ocaml valid="Validation.float_min 0.1">;
  color: color;
  show_vfx: bool;
}

(* [team] = Ally marks the place the party appears when it enters the stage; absent = a monster
   spawn point (the quest says who spawns there). [radius] is the monsters' area: they appear
   spread inside this disc around the anchor and roam in it until they aggro (absent = a point, no area) *)
type anchor_spawn_point = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  ?binding: anchor_binding option;
  ?team: character_team option;
  ?radius: float option <ocaml valid="Validation.float_min_if_some 0.5">;
}

type anchor_portal = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  ?binding: anchor_binding option;
}

type anchor_quest_board = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  ?binding: anchor_binding option;
}

(* A post the party lights with the interact key (a short channel); lit, it stays lit for the run and shines on
   everybody. [model] is the key of the pack prop that stands there (one field: the model is a pick of the owner) *)
type anchor_lamp_post = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  ?binding: anchor_binding option;
  model: string <ocaml valid="Validation.string_min_length 1">;
}

(* A shrine the party pays gold at (the interact key, instant, once per run of the stage): it refills the health and mana
   of the living party within reach. [model] is the key of the pack prop that stands there. [price] is the gold each living
   player of the party pays for one use: fixed, it never grows with the level or the tier (docs/systems/loot.md) *)
type anchor_healing_shrine = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  ?binding: anchor_binding option;
  model: string <ocaml valid="Validation.string_min_length 1">;
  price: int <ocaml valid="Validation.int_min 1">;
}

(* A lever the party pulls with the interact key (instant, once): it opens the gates of the stage that name it (stage
   [gates], opening Interact or FromSide). [model] is the key of the pack prop that stands there. *)
type anchor_lever = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  ?binding: anchor_binding option;
  model: string <ocaml valid="Validation.string_min_length 1">;
}

(* The gold of one item, by its rarity (an item of quality None counts as Common). Fixed: it never grows with the level
   or the tier (docs/systems/loot.md "Merchant") *)
type rarity_prices = {
  common: int <ocaml valid="Validation.int_min 1">;
  uncommon: int <ocaml valid="Validation.int_min 1">;
  rare: int <ocaml valid="Validation.int_min 1">;
  epic: int <ocaml valid="Validation.int_min 1">;
  legendary: int <ocaml valid="Validation.int_min 1">;
}

(* Relative weights of the kinds of piece the merchant stocks (weights, not percentages; the sum must be positive) *)
type merchant_kind_weights = {
  equipment: int <ocaml valid="Validation.int_min 0">;
  weapon: int <ocaml valid="Validation.int_min 0">;
} <ocaml valid="Validation.validate_merchant_kind_weights">

(* The shelf of [size] pieces, rolled when a run starts and again each time the party enters the village from a quest. A
   piece is rolled by [rarity] and [kinds]; a rarity with no unlocked candidate falls to the next lower one. The merchant
   never stocks a Legendary or a skill stone, whatever the weights say *)
type merchant_stock = {
  size: int <ocaml valid="Validation.int_min 1">;
  rarity: rarity_weights;
  kinds: merchant_kind_weights;
}

(* The one piece she keeps aside for the whole run, rolled when the run starts and kept until bought *)
type merchant_showcase = {
  rarity: rarity_weights;
}

(* The village merchant: the party buys, commissions and sells gear here with the interact key (a panel), in the village
   while a run is in progress. [model] is the key of the pack prop that stands there. She sells a piece for its price in
   [prices], pays [sell_fraction] of that price for a piece of the bag (rounded down, at least 1), and makes a random
   piece of a slot the buyer names for [commission_price] (docs/systems/loot.md "Merchant"). While a run is in
   progress she stands in front of her cart as the hero model wearing [outfit] (equipment references, no weapon):
   a hooded or cloaked look is picked from the equipment that exists *)
type anchor_merchant = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  ?binding: anchor_binding option;
  model: string <ocaml valid="Validation.string_min_length 1">;
  outfit: entity_reference list <ocaml valid="Validation.entity_reference_list_of_type 0 `Equipment">;
  prices: rarity_prices;
  sell_fraction: float <ocaml valid="Validation.float_between 0. 1.">;
  commission_price: int <ocaml valid="Validation.int_min 1">;
  stock: merchant_stock;
  showcase: merchant_showcase;
}

(* A chest the party opens with the interact key (instant, once per run of the stage) once the monsters that guard it are
   dead: each member of the party then gets one piece in its bag, rolled for it with a floor of [min_quality] (a rarity,
   Uncommon to Epic). [model] is the key of the pack prop that stands there. [guard] is the SpawnPoint anchor of the
   same stage whose monsters guard it: the chest is refused while one of them lives. Nothing of what is inside shows
   before it is opened (docs/systems/chest.md in fey-rs) *)
type anchor_chest = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  ?binding: anchor_binding option;
  model: string <ocaml valid="Validation.string_min_length 1">;
  min_quality: quality_type <ocaml valid="Validation.quality_uncommon_to_epic">;
  guard: entity_reference <ocaml valid="Validation.entity_reference_of_type `Anchor">;
}

type anchor_internal =
  [ Zone of anchor_zone
  | SpawnPoint of anchor_spawn_point
  | Portal of anchor_portal
  | QuestBoard of anchor_quest_board
  | LampPost of anchor_lamp_post
  | HealingShrine of anchor_healing_shrine
  | Lever of anchor_lever
  | Merchant of anchor_merchant
  | Chest of anchor_chest
  ] <json adapter.ocaml="Atdgen_runtime.Json_adapter.Type_field">
