type metadata <ocaml from="Common"> = abstract
type transform <ocaml from="Common"> = abstract
type color <ocaml from="Common"> = abstract
type character_team <ocaml from="Effect"> = abstract
type anchor_binding <ocaml from="Generator"> = abstract

type anchor_type =
  [ Zone
  | SpawnPoint
  | Portal
  | QuestBoard
  | LampPost
  ]

type zone_detection_type =
  [ Overlap
  | Trigger
  ]

(* Gameplay markers owned by a stage; transforms are relative to the stage's StageOrigin *)
type anchor = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  (* On a stage with a generator: which generated slot this anchor is; see [anchor_binding] *)
  ?binding: anchor_binding option;
}

(* [models] = the keys of the pack props a zone can stand as (a cocoon): the sim picks one per run from the run seed
   and the anchor's binding ordinal, so the zones of a slot rotate through the list and differ. Absent = a bare disc *)
type anchor_zone = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  ?binding: anchor_binding option;
  ?models: string list option <ocaml valid="Validation.validate_model_keys_if_some">;
  detection: zone_detection_type;
  radius: float <ocaml valid="Validation.float_min 0.1">;
  color: color;
  show_vfx: bool;
}

(* [team] = Ally marks the place the party appears when it enters the stage; absent = a monster
   spawn point (the quest says who spawns there). [radius] is the monsters' area: they appear
   spread inside this disc around the anchor and roam in it until they aggro (absent = a point, no area) *)
type anchor_spawn_point = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  ?binding: anchor_binding option;
  ?team: character_team option;
  ?radius: float option <ocaml valid="Validation.float_min_if_some 0.5">;
}

type anchor_portal = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  ?binding: anchor_binding option;
}

type anchor_quest_board = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  ?binding: anchor_binding option;
}

(* A post the party lights with the interact key (a short channel); lit, it stays lit for the run and shines on
   everybody. [model] is the key of the pack prop that stands there (one field: the model is a pick of the owner) *)
type anchor_lamp_post = {
  anchor_type <json name="type">: anchor_type;
  metadata: metadata;
  transform: transform;
  ?binding: anchor_binding option;
  model: string <ocaml valid="Validation.string_min_length 1">;
}

type anchor_internal =
  [ Zone of anchor_zone
  | SpawnPoint of anchor_spawn_point
  | Portal of anchor_portal
  | QuestBoard of anchor_quest_board
  | LampPost of anchor_lamp_post
  ] <json adapter.ocaml="Atdgen_runtime.Json_adapter.Type_field">
