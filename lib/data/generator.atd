type entity_reference <ocaml from="Common"> = abstract
type int_range <ocaml from="Common"> = abstract
type float_range <ocaml from="Common"> = abstract

(* Map generation data contract (docs/design/mapgen.md in fey-rs). The generator itself lives in Rust only
   (fey_core::mapgen); these types are the spec it reads and the checks fey-data runs on it at build time. *)

(* What a room is for. Roles are what a quest and a requirement talk about. *)
type room_role =
  [ Entrance
  | Combat
  | Ambush
  | Rest
  | Treasure
  | Objective
  | Boss
  | Filler
  ]

(* The anchors a room carries. A quest anchor on a generated stage is bound to (slot, ordinal). *)
type anchor_slot =
  [ PlayerSpawn
  | EntryPortal
  | PackSpawn
  | BossSpawn
  | ExitPortal
  | Shrine
  | Chest
  | ObjectiveZone
  (* the middle of a path between two rooms: no room is asked for, one anchor exists per path *)
  | TrailSpawn
  (* in the water beside a path between two rooms (swamp): one anchor per path *)
  | WaterSpawn
  (* a spot of the side grove of a swamp: the room's cocoons *)
  | Cocoon
  (* the middle of a filler island: no room is asked for, the layout has a few (a lamp post stands on one) *)
  | Marker
  ]

(* The theme turns it into units *)
type room_size =
  [ Small
  | Medium
  | Large
  | Huge
  ]

(* Which part of the room graph a requirement may use: the main path, the end of a side branch, or the main path first *)
type path_rule =
  [ MainPath
  | Branch
  | Any
  ]

(* One builder per kind (Cave later) *)
type generator_kind =
  [ Crypt
  | Forest
  | Swamp
  ]

(* PerRun: the layout seed is derived from the master seed, the stage and the run counter (a new layout every run).
   Fixed: [fixed_seed] of the spec. *)
type seed_policy =
  [ PerRun
  | Fixed
  ]

(* The side of a pinned room its door is on, in world axes *)
type facing =
  [ PosX
  | PosZ
  | NegX
  | NegZ
  ]

(* A point on the ground plane *)
type plane_point = {
  x: float;
  z: float;
}

(* Where a required room may stand, in graph depth (rooms from the entrance, entrance = 0). [farthest]: the last room of
   the main path and the deepest of the graph. [chokepoint]: on every route from the entrance to the farthest room.
   Absent = false / 0 / no limit. *)
type room_placement = {
  ?farthest: bool option;
  ?min_depth: int option <ocaml valid="Validation.int_min_if_some 0">;
  ?max_depth: int option <ocaml valid="Validation.int_min_if_some 0">;
  ?chokepoint: bool option;
}

(* Hints for content and art. [max_enemies] caps what a quest spawns in the room, [torches] is decor, [min_exits] is the
   least number of connections the room has. *)
type room_tags = {
  ?max_enemies: int option <ocaml valid="Validation.int_min_if_some 0">;
  ?torches: bool option;
  ?min_exits: int option <ocaml valid="Validation.int_min_if_some 0">;
}

(* One kind of room the stage must ([hard], the default) or should have. Soft: missing rooms only lower the score by
   [weight] (default 1). [min_spacing]: graph distance between two rooms of this requirement. [prefab]: a RoomPrefab
   every room of this requirement uses. [path] absent = Any. *)
type room_requirement = {
  role: room_role;
  min: int <ocaml valid="Validation.int_min 0">;
  max: int <ocaml valid="Validation.int_min 0">;
  ?hard: bool option;
  size: room_size;
  ?placement: room_placement option;
  ?path: path_rule option;
  ?min_spacing: int option <ocaml valid="Validation.int_min_if_some 0">;
  ?prefab: entity_reference option <ocaml valid="Validation.entity_reference_of_type_if_some `RoomPrefab">;
  ?tags: room_tags option;
  ?weight: float option <ocaml valid="Validation.float_min_if_some 0.">;
}

(* [main_path]: rooms on the main path, entrance and farthest room included. [loops]: extra connections that close a
   cycle (never through the entrance or the boss arena). [maze]: loops may end in the entrance and the boss arena, which
   each get a second way in, and join main-path rooms only so the side branches stay dead ends. [dead_ends]: whether a
   side room may have one connection. [branch_len]: rooms in a side branch. *)
type connection_rules = {
  main_path: int_range;
  loops: int_range;
  ?maze: bool option;
  dead_ends: bool;
  branch_len: int_range;
}

(* Two roles never directly connected *)
type role_pair = {
  a: room_role;
  b: room_role;
}

(* A hand-made room that must appear, optionally at a fixed place. [at]: the world position of its centre. [facing]: the
   side its door is on (the generator turns the whole map to match). Role Boss with [at] and [facing] is a statically
   placed boss arena: the rest of the map is built around it. Only one pinned prefab may have [at]. *)
type pinned_prefab = {
  prefab: entity_reference <ocaml valid="Validation.entity_reference_of_type `RoomPrefab">;
  role: room_role;
  ?at: plane_point option;
  ?facing: facing option;
}

(* Difficulty bounds measured on the finished layout; a layout outside them is re-rolled. [boss_path]: walking distance
   in units from the player spawn to the boss. *)
type par_rule = {
  boss_path: float_range;
}

(* What the generator needs besides the seed. [version]: the generator version the spec was tuned for. [party_size]
   (default 4) and [corridor_width] (default 8; raised to the party minimum) size the corridors. [fill]: the role of
   main-path rooms no requirement claims. [max_attempts] (default 64): derived seeds tried before giving up.
   [candidates] (default 1): valid layouts scored, the best is kept. *)
type generator_spec = {
  generator: generator_kind;
  version: int <ocaml valid="Validation.int_min 1">;
  requirements: room_requirement list <ocaml valid="Validation.list_min_length 1">;
  connections: connection_rules;
  ?forbidden_adjacent: role_pair list option;
  ?pinned: pinned_prefab list option;
  ?party_size: int option <ocaml valid="Validation.int_min_if_some 1">;
  ?corridor_width: float option <ocaml valid="Validation.float_min_if_some 1.">;
  fill: room_role;
  ?max_attempts: int option <ocaml valid="Validation.int_min_if_some 1">;
  ?candidates: int option <ocaml valid="Validation.int_min_if_some 1">;
  ?par: par_rule option;
  seed_policy: seed_policy;
  ?fixed_seed: int option <ocaml valid="Validation.int_min_if_some 0">;
}

(* A generated stage's anchor is the [ordinal]-th (default 0, counted by room depth then room) anchor of [slot] in the
   layout; the anchor's transform is the hand-made fallback and is ignored by the generator.
   With [every] the anchor is a template: the generator makes one anchor of it per [slot] in the layout (so [ordinal]
   must be absent), only allowed on the anchor kinds that make sense repeated (LampPost). *)
type anchor_binding = {
  slot: anchor_slot;
  ?ordinal: int option <ocaml valid="Validation.int_min_if_some 0">;
  ?every: bool option;
}
