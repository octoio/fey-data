# Fey Data Configuration
# This file contains paths and settings for the fey-data pipeline.
# Every path is relative to this config file (the fey-data folder).

# Entity JSON (<name>.<type>.json), the game data
json_path = "../fey-rs/data/json"

# Media the entities name (images, audio, models); validation checks the files exist
media_path = "../fey-assets/game-media"

# Index of the entity references, written on every run
entity_index_path = "../fey-rs/data/entity-reference-indices.json"

# Rust serde types, generated from the ATD schemas
rust_output_path = "../fey-rs/crates/fey_data/src/generated"
