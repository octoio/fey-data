# Fey Data Configuration
# This file contains paths and settings for the fey-data pipeline

# Game project root directory (relative to this config file)
game_root = "../fey"

# Streaming assets path (relative to game_root)
streaming_assets_path = "Assets/StreamingAssets"

# JSON data path (relative to streaming_assets_path)
json_path = "json"

# Scripts output path (relative to game_root)
scripts_path = "Assets/Scripts/Octoio/Fey/Data/Dto"

# Rust output directory for the generated serde types (relative to this config file).
# Skipped with a warning when the parent directory does not exist.
rust_output_path = "../fey-rs/crates/fey_data/src/generated"
